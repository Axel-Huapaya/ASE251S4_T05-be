# Stage 1: Build with Maven
FROM anafelix/maven:3.9-amazoncorretto-25-alpine AS builder
WORKDIR /app
COPY pom.xml .
COPY src ./src
RUN mvn clean package -DskipTests

# Stage 2: Run with Java
FROM anafelix/eclipse-temurin:25-jre-alpine
WORKDIR /app
COPY --from=builder /app/target/*.jar app.jar
ENTRYPOINT ["java", "-jar", "app.jar"]


# ==============================================================================
# COMANDOS DE CONSTRUCCIÓN Y PUBLICACIÓN EN DOCKER HUB (ANA FELIX #05)
# ==============================================================================

# 1. Construir la imagen desde la raíz del proyecto:
# docker build -t anafelix/s5-springwebflux-mongodb:1.0 -f dockerfile-ana/dockerfile .

# 2. Probar el contenedor localmente:
# docker run -d --name springwebflux-mongodb -p 8081:8081 anafelix/s5-springwebflux-mongodb:1.0

# 3. Subir la imagen a Docker Hub:
# docker push anafelix/s5-springwebflux-mongodb:1.0

# ------------------------------------------------------------------------------
# Referencias de imágenes base personalizadas en Docker Hub:
# docker pull maven:3.9-amazoncorretto-25-alpine
# docker tag maven:3.9-amazoncorretto-25-alpine anafelix/maven:3.9-amazoncorretto-25-alpine
# docker push anafelix/maven:3.9-amazoncorretto-25-alpine

# docker pull eclipse-temurin:25-jre-alpine
# docker tag eclipse-temurin:25-jre-alpine anafelix/eclipse-temurin:25-jre-alpine
# docker push anafelix/eclipse-temurin:25-jre-alpine
